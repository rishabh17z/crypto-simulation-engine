# ---------------------------------------------------------------------------
# Bybit TESTNET credentials (https://testnet.bybit.com -> API Management)
# NEVER put mainnet keys in this file.
# ---------------------------------------------------------------------------
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Exchange behaviour
EXCHANGE_ID=bybit
USE_SANDBOX=true
MARKET_TYPE=swap               # swap (linear perps, shorts allowed) | spot
PLACE_TESTNET_ORDERS=false     # true => also submit real orders to the testnet matching engine

# Capital & risk
INITIAL_CORPUS=10000
MAX_RISK_PER_TRADE=0.05        # 5% of equity
POSITION_SIZING_MODE=notional  # notional | risk
MAX_PORTFOLIO_EXPOSURE=0.60
MAX_OPEN_POSITIONS=3
ALLOW_SHORTS=true

# Simulated microstructure
FEE_RATE=0.001                 # 0.1% per side
SLIPPAGE_RATE=0.001            # 0.1% adverse

# Schedule
CYCLE_HOURS=4
EXPERIMENT_DAYS=30

# Sentiment
SENTIMENT_ENABLED=true         # false => trade on technicals alone, no HTTP calls at all
CRYPTOPANIC_TOKEN=
FEAR_GREED_URL=https://api.alternative.me/fng/
CRYPTOPANIC_URL=https://cryptopanic.com/api/v1/posts/
SENTIMENT_HTTP_TIMEOUT=12      # seconds; lower it if a source is firewalled on your network
SENTIMENT_MAX_RETRIES=3
SENTIMENT_CACHE_TTL=900        # re-use a successful fetch for 15 min
SENTIMENT_FAILURE_COOLDOWN=600 # after a failure, do not retry that source for 10 min

LOG_LEVEL=INFO
